<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_tenant_guard_module_rule" model="ir.rule">
        <field name="name">SaaS Tenant: Restrict module installation</field>
        <field name="model_id" ref="model_ir_module_module"/>
        <field name="groups" eval="[(4, ref('saas_tenant_guard.group_saas_tenant_admin'))]"/>
           <field name="perm_read" eval="True"/>
           <!-- Disallow write (module installation) for tenant admins. Modules are installed automatically when a pack is assigned.
               This prevents users from installing modules outside of their pack. -->
           <field name="perm_write" eval="False"/>
           <field name="perm_create" eval="False"/>
           <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Removed rule for group_saas_tenant to avoid conflicts -->

    <record id="saas_tenant_guard_config_parameter_rule" model="ir.rule">
        <field name="name">SaaS Tenant: Protect SaaS config parameters</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="domain_force">[
            ('key', 'not like', 'saas_tenant_guard.%')
        ]</field>
        <field name="groups" eval="[(4, ref('saas_tenant_guard.group_saas_tenant_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="saas_tenant_guard_users_limit_rule" model="ir.rule">
        <field name="name">SaaS Tenant: View users (limited)</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('saas_tenant_guard.group_saas_tenant_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
