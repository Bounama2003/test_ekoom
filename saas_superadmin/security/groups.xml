<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_saas_superadmin" model="res.groups">
        <field name="name">SaaS Super Admin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="comment">Super Admin Group for SaaS Multi-Tenant Administration. Only accessible on MASTER database.</field>
    </record>

    <record id="group_saas_manager" model="res.groups">
        <field name="name">SaaS Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Manager group for SaaS operations.</field>
    </record>
</odoo>
