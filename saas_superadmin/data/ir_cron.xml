<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron to recompute les informations des utilisateurs pour tous les tenants chaque jour -->
        <record id="ir_cron_recompute_user_count" model="ir.cron">
            <field name="name">Recompute User Count for Tenants</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="state">code</field>
            <field name="code">model.action_recompute_user_count()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>