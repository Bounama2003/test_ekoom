<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Vue Liste des Tenants -->
        <record id="view_saas_tenant_list" model="ir.ui.view">
            <field name="name">saas.tenant.list</field>
            <field name="model">saas.tenant</field>
            <field name="arch" type="xml">
                <list string="SaaS Tenants" default_order="name asc" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-warning="state == 'suspended'" decoration-muted="state == 'archived'">
<header>
    <button name="action_create_tenant_wizard" string="Create Tenant (with DB)" type="object" class="oe_highlight"/>
    <!-- Bouton pour recalculer le champ `users_info` depuis la vue liste -->
    <!-- Bouton serveur pour recalculer le nombre d'utilisateurs du tenant -->
    <button name="action_recompute_user_count" string="Recalculer le nb d'utilisateurs" type="object" class="oe_highlight"/>
</header>
                    <field name="name"/>
                    <field name="database_name"/>
                    <field name="company_name"/>
                    <field name="pack_id"/>
                    <field name="state" widget="badge"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="user_count"/>
                    <field name="max_users"/>
                    <field name="user_limit_reached" widget="boolean" decoration-danger="user_limit_reached"/>
                    <!-- Nouvelle colonne affichant la liste des utilisateurs du tenant (texte) -->
                    <button name="action_activate" string="Activate" type="object" icon="fa-check" invisible="state != 'draft'"/>
                    <button name="action_suspend" string="Suspend" type="object" icon="fa-pause" invisible="state != 'active'"/>
                    <button name="action_reactivate" string="Reactivate" type="object" icon="fa-play" invisible="state != 'suspended'"/>
                </list>
            </field>
        </record>

        <!-- Vue Formulaire des Tenants -->
        <record id="view_saas_tenant_form" model="ir.ui.view">
            <field name="name">saas.tenant.form</field>
            <field name="model">saas.tenant</field>
            <field name="arch" type="xml">
                <form string="SaaS Tenant">
<header>
    <button name="action_assign_pack_wizard" string="Assign Pack" type="object" invisible="state == 'archived'"/>
    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
    <button name="action_suspend" string="Suspend" type="object" invisible="state != 'active'"/>
    <button name="action_reactivate" string="Reactivate" type="object" invisible="state != 'suspended'"/>
    <button name="action_archive" string="Archive" type="object" invisible="state not in ['suspended', 'draft']"/>
    <button name="action_unarchive" string="Unarchive" type="object" invisible="state != 'archived'"/>
    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended"/>
    <!-- Bouton pour recalculer le champ `users_info` sur tous les tenants -->
    <!-- Bouton serveur pour recalculer le nombre d'utilisateurs du tenant -->
    <button name="action_recompute_user_count" string="Recalculer le nb d'utilisateurs" type="object" class="oe_highlight"/>
</header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Tenant Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Database Information">
                                <field name="database_name"/>
                                <field name="company_name"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group string="SaaS Configuration">
                                <field name="pack_id" options="{'no_create': True}"/>
                                <field name="admin_email" widget="email"/>
                                <field name="admin_password" string="Admin Password" placeholder="Password for admin user (leave empty to skip DB creation)"/>
                                <field name="admin_phone" widget="phone"/>
                            </group>
                        </group>
                        <notebook>
                        <page string="User Management" name="users">
                            <group>
                                <group>
                                    <field name="user_count"/>
                                    <field name="max_users"/>
                                </group>
                                <group>
                                    <field name="user_limit_reached" widget="boolean_toggle"/>
                                </group>
                                </group>
                        </page>
                            <page string="Dates &amp; Tracking" name="dates">
                                <group>
                                    <group>
                                        <field name="creation_date" readonly="1"/>
                                        <field name="activation_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="deactivation_date" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Internal Notes" name="notes">
                                <field name="notes" placeholder="Internal notes regarding this tenant..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vue Recherche des Tenants -->
        <record id="view_saas_tenant_search" model="ir.ui.view">
            <field name="name">saas.tenant.search</field>
            <field name="model">saas.tenant</field>
            <field name="arch" type="xml">
                <search string="Search Tenants">
                    <field name="name"/>
                    <field name="database_name"/>
                    <field name="company_name"/>
                    <field name="pack_id"/>
                    <field name="state"/>
                    <field name="admin_email"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active State" name="state_active" domain="[('state', '=', 'active')]"/>
<filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
<filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
<separator/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Business Pack" name="group_pack" context="{'group_by': 'pack_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_name'}"/>
                </search>
            </field>
        </record>

        <!-- Action pour les Tenants -->
        <record id="action_saas_tenant" model="ir.actions.act_window">
            <field name="name">SaaS Tenants</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">saas.tenant</field>
            <field name="view_id" ref="view_saas_tenant_list"/>
            <field name="view_mode">list,form,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first SaaS Tenant
                </p>
                 <p>
                    Tenants are your customers. Each tenant has its own database and business pack.
                </p>
            </field>
        </record>
    </data>
</odoo>
