<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Vue Formulaire du Wizard de Désactivation -->
        <record id="view_saas_deactivate_tenant_form" model="ir.ui.view">
            <field name="name">saas.deactivate.tenant.form</field>
            <field name="model">saas.deactivate.tenant</field>
            <field name="arch" type="xml">
                <form string="Deactivate Tenant">
                    <sheet>
                        <group>
                            <group>
                                <field name="tenant_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="user_count" readonly="1"/>
                                <field name="active_modules_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Deactivation Options">
                            <field name="archive_database"/>
                            <field name="deactivation_reason" required="1" placeholder="Reason for deactivation..."/>
                        </group>
                        <!-- Alerte stylisée Odoo 19 -->
                        <div class="alert alert-warning" role="alert">
                            <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                            <strong>Warning:</strong> Deactivating a tenant will suspend access to their database.
                            If you choose to archive, the tenant will be permanently archived.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_deactivate" string="Deactivate Tenant" type="object" class="btn-danger" data-hotkey="q"/>
                        <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action de fenêtre pour la Désactivation (Remplace act_window) -->
        <record id="action_saas_deactivate_tenant" model="ir.actions.act_window">
            <field name="name">Deactivate</field>
            <field name="res_model">saas.deactivate.tenant</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <!-- Liaison au menu "Actions" du modèle saas.tenant -->
            <field name="binding_model_id" ref="model_saas_tenant"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>
