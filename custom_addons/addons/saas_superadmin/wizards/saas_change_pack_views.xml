<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Vue Formulaire du Wizard de Changement de Pack -->
        <record id="view_saas_change_pack_form" model="ir.ui.view">
            <field name="name">saas.change.pack.form</field>
            <field name="model">saas.change.pack</field>
            <field name="arch" type="xml">
                <form string="Change Business Pack">
                    <sheet>
                        <group>
                            <group>
                                <field name="tenant_id" readonly="1"/>
                                <field name="current_pack_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="new_pack_id" required="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Modules to Add" name="add_modules">
                                <field name="modules_to_add" nolabel="1" widget="many2many_tags" readonly="1"/>
                            </page>
                            <page string="Modules to Remove" name="remove_modules">
                                <field name="modules_to_remove" nolabel="1" widget="many2many_tags" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_change_pack" string="Change Pack" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action de fenêtre pour le Changement de Pack (Remplace act_window) -->
        <record id="action_saas_change_pack" model="ir.actions.act_window">
            <field name="name">Change Pack</field>
            <field name="res_model">saas.change.pack</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <!-- Liaison au menu "Actions" du modèle saas.tenant -->
            <field name="binding_model_id" ref="model_saas_tenant"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>
