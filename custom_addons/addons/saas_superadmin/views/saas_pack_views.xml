<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_saas_pack_list" model="ir.ui.view">
            <field name="name">saas.pack.list</field>
            <field name="model">saas.pack</field>
            <field name="arch" type="xml">
                <list string="SaaS Packs" default_order="sequence asc, name asc">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="active"/>
                    <field name="tenant_count"/>
                    <button name="action_view_tenants" string="View Tenants" type="object" icon="fa-users"/>
                    <button name="action_view_modules" string="View Modules" type="object" icon="fa-cubes"/>
                </list>
            </field>
        </record>

        <record id="view_saas_pack_form" model="ir.ui.view">
            <field name="name">saas.pack.form</field>
            <field name="model">saas.pack</field>
            <field name="arch" type="xml">
                <form string="SaaS Pack">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tenants" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="tenant_count" widget="statinfo" string="Tenants"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="category_id"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="is_predefined"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Add a description..."/>
                            </page>
                            <page string="Included Modules" name="modules">
                                <field name="module_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_saas_pack_search" model="ir.ui.view">
            <field name="name">saas.pack.search</field>
            <field name="model">saas.pack</field>
            <field name="arch" type="xml">
                <search string="Search Packs">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="category_id"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Agro-Business" name="agro" domain="[('category_id.code', '=', 'agro')]"/>
                    <filter string="Logistics" name="logistics" domain="[('category_id.code', '=', 'logistics')]"/>
                    <filter string="Real Estate" name="real_estate" domain="[('category_id.code', '=', 'real_estate')]"/>
                    <separator/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                </search>
            </field>
        </record>

        <record id="action_saas_pack" model="ir.actions.act_window">
            <field name="name">SaaS Business Packs</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">saas.pack</field>
            <field name="view_mode">list,form,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Business Pack
                </p>
                <p>
                    Packs define which Odoo modules are available for tenants based on their business needs.
                </p>
            </field>
        </record>

        <!-- Category Model Views -->
        <record id="view_saas_pack_category_tree" model="ir.ui.view">
            <field name="name">saas.pack.category.tree</field>
            <field name="model">saas.pack.category</field>
            <field name="arch" type="xml">
                <list string="SaaS Pack Categories" default_order="name asc">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_saas_pack_category_form" model="ir.ui.view">
            <field name="name">saas.pack.category.form</field>
            <field name="model">saas.pack.category</field>
            <field name="arch" type="xml">
                <form string="SaaS Pack Category">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_saas_pack_category" model="ir.actions.act_window">
            <field name="name">SaaS Pack Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">saas.pack.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define custom SaaS pack categories (niches).
                </p>
            </field>
        </record>
    <record id="view_ir_module_module_tree" model="ir.ui.view">
        <field name="name">ir.module.module.tree</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
        <list string="Modules">
            <field name="name"/>
            <field name="state"/>
        </list>
        </field>
    </record>

    <record id="action_view_modules" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_ir_module_module_tree"/>
    </record>

    </data>
</odoo>
